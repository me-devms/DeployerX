{
  "name": "deployerx",
  "version": "0.2.1",
  "description": "Cross-platform desktop deployment helper for SSH based servers.",
  "author": {
    "name": "Manish K",
    "email": "lxsuthar1@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/me-devms/DeployerX.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "database-native:accept": "node src/database-manager/native-live-acceptance.js",
    "database-plugin:accept": "node src/database-manager/plugin-live-acceptance.js",
    "database-firestore:accept": "firebase emulators:exec --config firebase.database-manager.json --only firestore --project demo-deployerx-database-manager \"node --test src/database-manager/firestore-rules-emulator.js\"",
    "database-native:licenses": "node src/database-manager/native-license-inventory.js",
    "database-native:review-request": "node src/database-manager/native-license-review-request.js --write",
    "database-windows:accept": "node src/database-manager/windows-artifact-acceptance.js",
    "database-access:prepare": "node scripts/prepare-db-access-manager.js --build",
    "database-access:validate": "node scripts/prepare-db-access-manager.js --validate-only",
    "database-access:licenses": "node scripts/db-access-manager-license-inventory.js",
    "database-access:license-review-request": "node scripts/db-access-manager-license-review-request.js --write",
    "database-access:license-check": "node scripts/db-access-manager-license-compliance.js --require-ready",
    "database-access:test": "node --test scripts/db-access-manager-license-compliance.test.js scripts/prepare-db-access-manager.test.js",
    "prepackage:win": "node --test src/database-manager/direct-driver-runtime.test.js scripts/prepare-db-access-manager.test.js",
    "package:win": "npm run database-access:prepare && npm run database-access:validate && npm exec --yes --package electron-builder@24.13.3 -- electron-builder --win nsis portable --x64 --publish never",
    "prepackage:win:app": "node --test src/database-manager/direct-driver-runtime.test.js",
    "package:win:app": "npm exec --yes --package electron-builder@24.13.3 -- electron-builder --config electron-builder.app-only.cjs --win nsis portable --x64 --publish never",
    "prepackage:linux": "node --test src/database-manager/direct-driver-runtime.test.js",
    "package:linux": "npm exec --yes --package electron-builder@24.13.3 -- electron-builder --linux AppImage deb rpm --x64 --publish never",
    "prepackage:mac:x64": "node --test src/database-manager/direct-driver-runtime.test.js",
    "package:mac:x64": "npm exec --yes --package electron-builder@24.13.3 -- electron-builder --mac dmg zip --x64 --publish never",
    "prepackage:mac:arm64": "node --test src/database-manager/direct-driver-runtime.test.js",
    "package:mac:arm64": "npm exec --yes --package electron-builder@24.13.3 -- electron-builder --mac dmg zip --arm64 --publish never"
  },
  "build": {
    "appId": "com.everythingx.deployerx",
    "productName": "DeployerX",
    "copyright": "Copyright (c) 2026 Manish K",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "THIRD_PARTY_NOTICES.md",
      "third_party_licenses/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "firebase.config.json",
        "to": "firebase.config.json"
      }
    ],
    "publish": [
      {
        "provider": "github"
      }
    ],
    "win": {
      "icon": "assets/deployerx-logo.ico",
      "signDlls": true,
      "extraResources": [
        {
          "from": "native/dist/deployerx-db-access-manager/win32-x64",
          "to": "db-access-manager",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeployerX"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/deployerx-logo.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/deployerx-logo.png",
      "category": "Development",
      "synopsis": "Deployment and server operations workspace",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@azure/storage-blob": "12.32.0",
    "@google-cloud/storage": "7.21.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cron-parser": "^5.4.0",
    "dompurify": "3.4.13",
    "electron-updater": "^6.8.9",
    "ironrdp-wasm": "^1.1.0",
    "jsonpath-plus": "^10.3.0",
    "luxon": "^3.7.2",
    "marked": "14.0.0",
    "monaco-editor": "0.56.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "sql-formatter": "15.8.2",
    "sql.js": "1.14.1",
    "ssh2": "^1.15.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@electron/asar": "3.2.17",
    "electron": "43.3.0",
    "js-yaml": "4.3.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "dompurify": "3.4.13",
    "js-yaml": "4.3.0",
    "whatwg-url": "14.2.0"
  }
}
